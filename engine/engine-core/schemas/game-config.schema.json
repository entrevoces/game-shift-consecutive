{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameConfig (spec §11.2 contract)",
  "type": "object",
  "required": ["gameId", "label", "domainIds", "engineUrl"],
  "properties": {
    "gameId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,48}$" },
    "label": { "type": "string" },
    "domainIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "competences": { "type": "array", "items": { "type": "string" } },
    "stages": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 8 } },
    "engineUrl": { "type": "string" },
    "offlineSeed": { "type": "string" },
    "version": { "type": "integer" }
  }
}
