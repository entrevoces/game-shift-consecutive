{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceEvent (closed schema — data minimization, spec §9.4)",
  "type": "object",
  "required": ["eventId", "learnerId", "domainId", "conceptId"],
  "additionalProperties": false,
  "properties": {
    "eventId": { "type": "string" },
    "learnerId": { "type": "string" },
    "domainId": { "type": "string" },
    "conceptId": { "type": "string" },
    "areaId": { "type": ["string", "null"] },
    "gameId": { "type": "string" },
    "activityType": { "type": "string", "enum": ["terminology", "conceptual", "contextual-usage", "bilingual", "retrieval", "listening", "spoken-production", "interpretation", "integrated", "judgment", "note-craft", "sight", "repair"] },
    "stage": { "type": "integer", "minimum": 1, "maximum": 8 },
    "languageDirection": { "type": "string" },
    "correct": { "type": "boolean" },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "assistance": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "fidelity": { "type": "string" },
    "misconceptionTag": { "type": "string" },
    "responseSummary": { "type": "string", "maxLength": 280 },
    "clientTs": { "type": "number" },
    "serverTs": { "type": "number" }
  }
}
