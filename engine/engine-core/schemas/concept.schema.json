{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept",
  "type": "object",
  "required": ["conceptId", "domainId", "areaIds", "terms", "definition", "sourceIds"],
  "properties": {
    "conceptId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,48}$" },
    "domainId": { "type": "string" },
    "areaIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "terms": { "type": "object", "additionalProperties": { "type": "object", "properties": { "term": { "type": "string" }, "alternatives": { "type": "array", "items": { "type": "string" } }, "register": { "type": "string" } }, "required": ["term"] } },
    "definition": { "type": "object", "properties": { "en": { "type": "string" } } },
    "distinctions": { "type": "array", "items": { "type": "object", "properties": { "contrast": { "type": "string" }, "difference": { "type": "string" } } } },
    "misconceptions": { "type": "array" },
    "examples": { "type": "array" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "competences": { "type": "array", "items": { "type": "string" } },
    "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "inferred": { "type": "boolean" }
  }
}
